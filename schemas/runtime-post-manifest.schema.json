{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brand-os/runtime-post-manifest/v1",
  "title": "Runtime post manifest v1",
  "description": "One drafted social post: the SVG file, its digest, the task_context sources it cites by id and revision, the assets it considered, and the checks reported by the layers that own them. A draft for human review; it authorizes nothing. $id is an identifier, not a deployed endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "post_id",
    "index",
    "brand_id",
    "demo",
    "state",
    "locale",
    "direction",
    "angle",
    "layout",
    "format",
    "file",
    "sha256",
    "bytes",
    "renderer",
    "context",
    "sources",
    "assets",
    "checks",
    "human_review_required",
    "authorizes",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "brand-os/runtime-post-manifest/v1"
    },
    "post_id": {
      "type": "string",
      "pattern": "^post-[0-9]{2}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "demo": {
      "type": "boolean"
    },
    "state": {
      "const": "draft"
    },
    "locale": {
      "enum": [
        "en",
        "fa",
        "tr"
      ]
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "angle": {
      "enum": [
        "promise",
        "differentiation",
        "value_proposition",
        "tagline",
        "audience",
        "offer",
        "purpose",
        "pillar"
      ]
    },
    "layout": {
      "enum": [
        "statement",
        "band",
        "frame",
        "split",
        "quote"
      ]
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height",
        "media_type"
      ],
      "properties": {
        "id": {
          "const": "instagram-portrait-1080x1350"
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1350
        },
        "media_type": {
          "const": "image/svg+xml"
        }
      }
    },
    "file": {
      "type": "string",
      "pattern": "^posts/post-[0-9]{2}\\.svg$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model",
        "network"
      ],
      "properties": {
        "name": {
          "const": "brand-os-svg-post-renderer"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "null"
        },
        "network": {
          "const": false
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_schema",
        "pack_sha256",
        "task_type"
      ],
      "properties": {
        "pack_schema": {
          "const": "brand-os/task-context/v1"
        },
        "pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_type": {
          "const": "social_batch"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "source_id",
          "source_revision"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "source_revision",
          "checksum_sha256",
          "model_use",
          "sent_to_model",
          "embedded",
          "not_embedded_reason"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_use": {
            "enum": [
              "not_allowed",
              "local_only",
              "external_allowed"
            ]
          },
          "sent_to_model": {
            "const": false
          },
          "embedded": {
            "type": "boolean"
          },
          "not_embedded_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "human_review_required": {
      "const": true
    },
    "authorizes": {
      "type": "array",
      "maxItems": 0
    },
    "permissions": {
      "$ref": "#/definitions/permissions"
    }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "layer",
        "method",
        "result",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z_]+\\.[a-z_]+$"
        },
        "layer": {
          "enum": [
            "asset-catalog.svg-check",
            "asset-catalog.publication",
            "asset-catalog.normalize",
            "content-bridge.claims",
            "design-tokens.contrast",
            "task-context.pack",
            "runtime.manifest"
          ]
        },
        "method": {
          "const": "deterministic"
        },
        "result": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_tested"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publish",
        "schedule",
        "spend",
        "deploy",
        "approve"
      ],
      "properties": {
        "publish": {
          "const": false
        },
        "schedule": {
          "const": false
        },
        "spend": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "approve": {
          "const": false
        }
      }
    }
  }
}
