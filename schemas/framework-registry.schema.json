{
  "$id": "https://brand-os.local/schemas/framework-registry.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visual framework registry",
  "description": "Metadata about frameworks and standards the visual renderers draw on, and what may be claimed about them. Never brand facts.",
  "type": "object",
  "required": ["schema_version", "frameworks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["framework_id", "title", "kind", "authority", "edition", "source_url", "license_status", "permitted_claim", "verified_on", "usage_note"],
        "additionalProperties": false,
        "properties": {
          "framework_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,39}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kind": { "enum": ["formal_standard", "professional_framework", "editorial_template"] },
          "authority": { "type": "string", "minLength": 1, "maxLength": 160 },
          "edition": { "type": "string", "minLength": 1, "maxLength": 160 },
          "source_url": { "type": "string", "pattern": "^https://[^\\s<>\"']+$", "maxLength": 300 },
          "license_status": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "permitted_claim": { "enum": ["informed_by", "aligned_with", "verified_against", "externally_certified", "original_professional_template"] },
          "verified_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "usage_note": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
