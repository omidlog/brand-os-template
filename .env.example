# Copy to .env for local overrides. Never commit .env or real tokens.
# Audience used by scripts that honor the environment. CLI flags win when both are set.
DOCS_AUDIENCE=internal

# Local documentation site. Replace when you actually deploy.
BRAND_OS_SITE_URL=http://localhost:3000

# Public builds exclude internal and restricted records.
# Set to 1 only in a trusted local process when debugging restricted answers.
BRAND_OS_ALLOW_RESTRICTED=0

# Optional integrations. Leave blank. Do not paste live secrets into Git.
FIGMA_ACCESS_TOKEN=
ASSET_BUCKET_URL=
NOTION_TOKEN=
