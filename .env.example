# Copy to .env for local overrides. Never commit .env or real tokens.
# Audience used by scripts that honor the environment. CLI flags win when both are set.
DOCS_AUDIENCE=internal

# Local documentation site. Replace when you actually deploy.
BRAND_OS_SITE_URL=http://localhost:3000

# Public builds exclude internal and restricted records.
# Set to 1 only in a trusted local process when debugging restricted answers.
BRAND_OS_ALLOW_RESTRICTED=0

# Encryption key for restricted answers (brand/.private) and backups. Required: both fail closed
# without it. Must be 32 random bytes, base64-encoded. Generate one locally with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Scripts do not load this file automatically. Export the value in your shell or secret manager.
# Losing the key makes existing restricted answers and backups unreadable. Never commit a real key.
# `npm run brand:doctor` checks that it is set and decodes to 32 bytes without printing it.
BRAND_OS_DATA_KEY=

# Optional integrations. Leave blank. Do not paste live secrets into Git.
FIGMA_ACCESS_TOKEN=
ASSET_BUCKET_URL=
NOTION_TOKEN=
